{% extends 'admin/layout.html.twig' %}

{% block title %}Créer un Cours - EducaVision{% endblock %}

{% block breadcrumb_title %}Créer un Cours{% endblock %}

{% block breadcrumb_items %}
<li><a href="{{ path('admin_dashboard') }}">Dashboard</a></li>
<li><a href="{{ path('admin_course_index') }}">Cours</a></li>
<li>Créer</li>
{% endblock %}

{% block body %}
<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fa fa-plus"></i>
                    Créer un nouveau cours
                </h5>
            </div>
            <div class="card-body">
                {% for flash_message in app.flashes('success') %}
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        {{ flash_message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}
                
                {% for flash_message in app.flashes('error') %}
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        {{ flash_message }}
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                {% endfor %}

                {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'enctype': 'multipart/form-data'}}) }}
                
                <div class="row">
                    <div class="col-md-8">
                        <div class="mb-3">
                            {{ form_label(form.titre, 'Titre du cours *', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.titre, {'attr': {
                                'class': 'form-control ' ~ (form.titre.vars.valid ? '' : 'is-invalid'),
                                'placeholder': 'Ex: Introduction à Symfony 6'
                            }}) }}
                            {% if form.titre.vars.errors|length > 0 %}
                                <div class="invalid-feedback">
                                    {% for error in form.titre.vars.errors %}
                                        {{ error.message }}
                                    {% endfor %}
                                </div>
                            {% endif %}
                            <small class="form-text text-muted">3-255 caractères requis</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="mb-3">
                            {{ form_label(form.category, 'Catégorie *', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.category, {'attr': {
                                'class': 'form-select ' ~ (form.category.vars.valid ? '' : 'is-invalid')
                            }}) }}
                            {% if form.category.vars.errors|length > 0 %}
                                <div class="invalid-feedback">
                                    {% for error in form.category.vars.errors %}
                                        {{ error.message }}
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    {{ form_label(form.description, 'Description *', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.description, {'attr': {
                        'class': 'form-control ' ~ (form.description.vars.valid ? '' : 'is-invalid'),
                        'rows': 6,
                        'placeholder': 'Décrivez en détail le contenu du cours, les prérequis, les objectifs...'
                    }}) }}
                    {% if form.description.vars.errors|length > 0 %}
                        <div class="invalid-feedback">
                            {% for error in form.description.vars.errors %}
                                {{ error.message }}
                            {% endfor %}
                        </div>
                    {% endif %}
                    <small class="form-text text-muted">10-2000 caractères requis</small>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="mb-3">
                            {{ form_label(form.price, 'Prix (€)', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.price, {'attr': {
                                'class': 'form-control ' ~ (form.price.vars.valid ? '' : 'is-invalid'),
                                'placeholder': '0.00',
                                'step': '0.01'
                            }}) }}
                            {% if form.price.vars.errors|length > 0 %}
                                <div class="invalid-feedback">
                                    {% for error in form.price.vars.errors %}
                                        {{ error.message }}
                                    {% endfor %}
                                </div>
                            {% endif %}
                            <small class="form-text text-muted">Laissez vide ou mettez 0 pour un cours gratuit</small>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="mb-3">
                            {{ form_label(form.status, 'Statut', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                            {{ form_widget(form.status, {'attr': {
                                'class': 'form-select'
                            }}) }}
                            <small class="form-text text-muted">Un cours inactif n'est pas visible par les étudiants</small>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    {{ form_label(form.pdfUpload, 'Fichier PDF', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.pdfUpload, {'attr': {
                        'class': 'form-control',
                        'accept': '.pdf'
                    }}) }}
                    <small class="form-text text-muted">PDF optionnel contenant le support de cours (max 20MB)</small>
                </div>

                <div class="mb-3">
                    {{ form_label(form.imageUrl, 'URL de l\'image', {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.imageUrl, {'attr': {
                        'class': 'form-control ' ~ (form.imageUrl.vars.valid ? '' : 'is-invalid'),
                        'placeholder': 'Laissez vide pour générer automatiquement'
                    }}) }}
                    {% if form.imageUrl.vars.errors|length > 0 %}
                        <div class="invalid-feedback">
                            {% for error in form.imageUrl.vars.errors %}
                                {{ error.message }}
                            {% endfor %}
                        </div>
                    {% endif %}
                    <small class="form-text text-muted">Laissez vide pour qu'une image soit générée automatiquement</small>
                </div>

                <div class="d-flex justify-content-between">
                    <a href="{{ path('admin_course_index') }}" class="btn btn-secondary">
                        <i class="fa fa-arrow-left"></i> Retour
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-plus"></i>
                        Créer le cours
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>

    <!-- Colonne latérale d'aide -->
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="fa fa-lightbulb"></i> Conseils
                </h6>
            </div>
            <div class="card-body">
                <ul class="list-unstyled small">
                    <li class="mb-2">
                        <i class="fa fa-check text-success"></i>
                        Utilisez un titre accrocheur et descriptif
                    </li>
                    <li class="mb-2">
                        <i class="fa fa-check text-success"></i>
                        Décrivez clairement les prérequis et objectifs
                    </li>
                    <li class="mb-2">
                        <i class="fa fa-check text-success"></i>
                        Choisissez une catégorie appropriée
                    </li>
                    <li class="mb-2">
                        <i class="fa fa-check text-success"></i>
                        Une image de qualité augmente l'attractivité
                    </li>
                </ul>
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="fa fa-info-circle"></i> Aide rapide
                </h6>
            </div>
            <div class="card-body">
                <p class="small mb-2">
                    <strong>Titre:</strong> 3-255 caractères, unique et descriptif
                </p>
                <p class="small mb-2">
                    <strong>Description:</strong> 10-2000 caractères, détails et objectifs
                </p>
                <p class="small mb-2">
                    <strong>Prix:</strong> 0-9999.99€, laissez vide pour gratuit
                </p>
                <p class="small mb-0">
                    <strong>PDF:</strong> Taille max 20MB, format .pdf uniquement
                </p>
            </div>
        </div>
    </div>
</div>
{% endblock %}

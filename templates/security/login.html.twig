        }

        .camera-overlay {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 180px;
            height: 220px;
            border: 3px solid rgba(79, 172, 254, 0.8);
            border-radius: 50% 50% 45% 45%;

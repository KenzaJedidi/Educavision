{% extends 'admin/layout.html.twig' %}

{% block title %}{{ utilisateur.prenom }} {{ utilisateur.nom }} - Admin{% endblock %}

{% block breadcrumb_title %}Détails de l'Utilisateur{% endblock %}
{% block breadcrumb_items %}
    <li><a href="{{ path('admin_user_index') }}">Utilisateurs</a></li>
    <li>{{ utilisateur.prenom }} {{ utilisateur.nom }}</li>
{% endblock %}

{% block body %}
<div class="row">
    <div class="col-lg-8 col-md-10 m-b30">
        <div class="widget-box">
            <div class="wc-title">
                <h4>{{ utilisateur.prenom }} {{ utilisateur.nom }}</h4>
            </div>
            <div class="widget-inner">
                <table class="table">
                    <tr>
                        <th style="width: 200px;">ID</th>
                        <td>{{ utilisateur.id }}</td>
                    </tr>
                    <tr>
                        <th>Prénom</th>
                        <td>{{ utilisateur.prenom }}</td>
                    </tr>
                    <tr>
                        <th>Nom</th>
                        <td>{{ utilisateur.nom }}</td>
                    </tr>
                    <tr>
                        <th>Email</th>
                        <td>{{ utilisateur.email }}</td>
                    </tr>
                    <tr>
                        <th>Rôle</th>
                        <td>
                            {% if utilisateur.role == 'admin' %}
                                <span class="badge badge-primary">Admin</span>
                            {% elseif utilisateur.role == 'professeur' %}
                                <span class="badge badge-info">Professeur</span>
                            {% else %}
                                <span class="badge badge-warning">Étudiant</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th>Statut</th>
                        <td>
                            {% if utilisateur.actif %}
                                <span class="badge badge-success">Actif</span>
                            {% else %}
                                <span class="badge badge-danger">Inactif</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th>Suspension</th>
                        <td>
                            {% if utilisateur.banUntil and utilisateur.banUntil > date() %}
                                <span class="badge badge-danger">
                                    ⛔ Suspendu jusqu'au {{ utilisateur.banUntil|date('d/m/Y à H:i') }}
                                </span>
                                {% if utilisateur.banReason %}
                                    <br><small class="text-muted mt-1 d-block">Raison : {{ utilisateur.banReason }}</small>
                                {% endif %}
                            {% else %}
                                <span class="badge badge-success">✓ Aucune suspension</span>
                            {% endif %}
                        </td>
                    </tr>
                    <tr>
                        <th>Téléphone</th>
                        <td>{{ utilisateur.telephone ?? '-' }}</td>
                    </tr>
                    <tr>
                        <th>Adresse</th>
                        <td>{{ utilisateur.adresse ?? '-' }}</td>
                    </tr>
                    <tr>
                        <th>Date d'inscription</th>
                        <td>{{ utilisateur.dateInscription ? utilisateur.dateInscription|date('d/m/Y H:i') : '-' }}</td>
                    </tr>
                    <tr>
                        <th>Dernière modification</th>
                        <td>{{ utilisateur.dateModification ? utilisateur.dateModification|date('d/m/Y H:i') : '-' }}</td>
                    </tr>
                </table>

                <div class="mt-3 d-flex flex-wrap gap-2" style="gap:8px;">
                    <a href="{{ path('admin_user_edit', {id: utilisateur.id}) }}" class="btn btn-primary">
                        <i class="fa fa-pencil"></i> Modifier
                    </a>
                    <a href="{{ path('admin_user_toggle', {id: utilisateur.id}) }}" class="btn btn-{{ utilisateur.actif ? 'warning' : 'success' }}">
                        <i class="fa fa-{{ utilisateur.actif ? 'ban' : 'check' }}"></i> {{ utilisateur.actif ? 'Désactiver' : 'Activer' }}
                    </a>

                    {# Ban / Unban #}
                    {% if utilisateur.banUntil and utilisateur.banUntil > date() %}
                        <a href="{{ path('admin_user_unban', {id: utilisateur.id}) }}"
                           class="btn btn-success"
                           onclick="return confirm('Lever la suspension de ce compte ?')">
                            <i class="fa fa-unlock"></i> Lever la suspension
                        </a>
                    {% else %}
                        <button type="button" class="btn btn-danger" data-toggle="modal" data-target="#banModal">
                            <i class="fa fa-gavel"></i> Suspendre
                        </button>
                    {% endif %}

                    <a href="{{ path('admin_user_index') }}" class="btn btn-secondary">
                        <i class="fa fa-arrow-left"></i> Retour
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

{# Ban Modal #}
<div class="modal fade" id="banModal" tabindex="-1" role="dialog" aria-labelledby="banModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <form action="{{ path('admin_user_ban', {id: utilisateur.id}) }}" method="POST">
                <input type="hidden" name="_token" value="{{ csrf_token('ban' ~ utilisateur.id) }}">
                <div class="modal-header" style="background:#e74c3c;color:white;">
                    <h5 class="modal-title" id="banModalLabel">⛔ Suspendre le compte</h5>
                    <button type="button" class="close" data-dismiss="modal" style="color:white;">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>Vous allez suspendre le compte de <strong>{{ utilisateur.prenom }} {{ utilisateur.nom }}</strong>.</p>
                    <p class="text-muted small">Un email de notification sera envoyé à l'utilisateur.</p>

                    <div class="form-group">
                        <label for="duration_days"><strong>Durée de la suspension</strong></label>
                        <select name="duration_days" id="duration_days" class="form-control">
                            <option value="1">1 jour</option>
                            <option value="3">3 jours</option>
                            <option value="7" selected>7 jours</option>
                            <option value="14">14 jours</option>
                            <option value="30">30 jours</option>
                            <option value="90">3 mois</option>
                            <option value="365">1 an</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="ban_reason"><strong>Raison de la suspension</strong></label>
                        <textarea name="reason" id="ban_reason" class="form-control" rows="3"
                                  placeholder="Ex: Non-respect des règles de la plateforme..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="fa fa-gavel"></i> Confirmer la suspension
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}

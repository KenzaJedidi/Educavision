{% extends 'admin/layout.html.twig' %}

{% block title %}{{ course.id ? 'Modifier' : 'Créer' }} un Cours - EducaVision{% endblock %}

{% block breadcrumb_title %}{{ course.id ? 'Modifier' : 'Créer' }} un Cours{% endblock %}

{% block breadcrumb_items %}
<li><a href="{{ path('admin_dashboard') }}">Dashboard</a></li>
<li><a href="{{ path('admin_course_index') }}">Cours</a></li>
<li>{{ course.id ? 'Modifier' : 'Créer' }}</li>
{% endblock %}

{% block body %}
<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h5 class="mb-0">
                    <i class="fa fa-{{ course.id ? 'edit' : 'plus' }}"></i>
                    {{ course.id ? 'Modifier' : 'Créer' }} un nouveau cours
                </h5>
            </div>
            <div class="card-body">
                <!-- Image actuelle -->
                {% if course.imageUrl and course.imageUrl is not empty %}
                <div class="mb-3">
                    <label class="form-label fw-bold">Image actuelle</label>
                    <div class="d-flex align-items-center">
                        <img src="{{ course.imageUrl }}" alt="{{ course.titre }}" 
                             class="rounded me-3" style="width: 100px; height: 80px; object-fit: cover;">
                        <div>
                            <small class="text-muted">{{ course.imageUrl }}</small>
                            <br>
                            <strong>TEMPLATE RECRÉÉ!</strong>
                        </div>
                    </div>
                </div>
                {% endif %}

                {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'enctype': 'multipart/form-data'}}) }}
                
                <div class="d-flex justify-content-between">
                    <a href="{{ path('admin_course_index') }}" class="btn btn-secondary">
                        <i class="fa fa-arrow-left"></i> Retour
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fa fa-{{ course.id ? 'save' : 'plus' }}"></i>
                        {{ course.id ? 'Mettre à jour' : 'Créer' }} le cours
                    </button>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>

    <!-- Colonne latérale d'aide -->
    <div class="col-md-4">
        <div class="card mb-3">
            <div class="card-header">
                <h6 class="mb-0">
                    <i class="fa fa-lightbulb"></i> Conseils
                </h6>
            </div>
            <div class="card-body">
                <ul class="list-unstyled small">
                    <li class="mb-2">
                        <i class="fa fa-check text-success"></i>
                        Utilisez un titre accrocheur et descriptif
                    </li>
                    <li class="mb-2">
                        <i class="fa fa-check text-success"></i>
                        Décrivez clairement les prérequis et objectifs
                    </li>
                    <li class="mb-2">
                        <i class="fa fa-check text-success"></i>
                        Choisissez une catégorie appropriée
                    </li>
                    <li class="mb-2">
                        <i class="fa fa-check text-success"></i>
                        Une image de qualité augmente l'attractivité
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
{% endblock %}

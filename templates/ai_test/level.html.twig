{% extends 'base.html.twig' %}

{% block title %}Test Détection de Niveau{% endblock %}

{% block body %}
<div class="container mt-5">
    <a href="{{ path('ai_test_index') }}" class="btn btn-outline-secondary mb-4">
        <i class="fas fa-arrow-left"></i> Retour
    </a>
    
    <h1 class="mb-4">
        <i class="fas fa-chart-line text-primary"></i>
        Test de Détection de Niveau
    </h1>

    <div class="row">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Entrez 3 scores de quiz</h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div class="mb-3">
                            <label class="form-label">Score Quiz 1 (%)</label>
                            <input type="number" class="form-control" name="score1" min="0" max="100" value="85" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Score Quiz 2 (%)</label>
                            <input type="number" class="form-control" name="score2" min="0" max="100" value="90" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Score Quiz 3 (%)</label>
                            <input type="number" class="form-control" name="score3" min="0" max="100" value="88" required>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-calculator"></i> Détecter le Niveau
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            {% if results %}
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Résultats</h5>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <h2 class="text-uppercase text-primary">{{ results.level }}</h2>
                        <p class="text-muted">Niveau détecté</p>
                    </div>

                    <div class="alert alert-info">
                        <strong>Moyenne:</strong> {{ results.average|round(1) }}%
                    </div>

                    <h6 class="fw-bold">Recommandations:</h6>
                    <div class="alert alert-light">
                        {{ results.recommendations.message }}
                    </div>

                    <div class="alert alert-success">
                        {{ results.recommendations.motivationalMessage }}
                    </div>

                    <h6 class="fw-bold">Prochain quiz:</h6>
                    <p>Difficulté: <span class="badge bg-primary">{{ results.recommendations.nextQuizDifficulty }}</span></p>

                    <h6 class="fw-bold">Sujets suggérés:</h6>
                    <ul>
                        {% for topic in results.recommendations.suggestedTopics %}
                        <li>{{ topic }}</li>
                        {% endfor %}
                    </ul>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

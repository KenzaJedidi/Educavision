<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Réinitialiser le mot de passe - EducaVision</title>
    <link rel="icon" href="{{ asset('front-assets/images/favicon.ico') }}" type="image/x-icon" />
    <link rel="stylesheet" type="text/css" href="{{ asset('assets/css/assets.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('assets/css/typography.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('assets/css/shortcodes/shortcodes.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('assets/css/style.css') }}">
    <link class="skin" rel="stylesheet" type="text/css" href="{{ asset('assets/css/color/color-1.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { box-sizing: border-box; }
        html, body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            font-family: 'Rubik', sans-serif;
        }

        body {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 40%, #0f3460 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .reset-card {
            width: 100%;
            max-width: 460px;
            background: #fff;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.4);
        }

        .reset-header {
            background: linear-gradient(135deg, #ff5e14 0%, #ff8e14 100%);
            padding: 32px 28px 28px;
            text-align: center;
        }

        .reset-header .logo-link {
            display: inline-block;
            background: #fff;
            padding: 10px 18px;
            border-radius: 12px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
        }

        .reset-header .logo-link img {
            height: 44px;
            width: auto;
            display: block;
        }

        .reset-header .icon-box {
            width: 72px;
            height: 72px;
            background: rgba(255, 255, 255, 0.25);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 16px auto 12px;
        }

        .reset-header .icon-box i {
            font-size: 32px;
            color: #fff;
        }

        .reset-header h1 {
            color: #fff;
            font-size: 22px;
            font-weight: 700;
            margin: 0 0 6px;
        }

        .reset-header p {
            color: rgba(255, 255, 255, 0.9);
            font-size: 14px;
            margin: 0;
        }

        .reset-body {
            padding: 32px 28px 36px;
        }

        .reset-body .alert {
            padding: 14px 18px;
            border-radius: 12px;
            font-size: 14px;
            margin-bottom: 20px;
            border: none;
        }

        .reset-body .alert-success {
            background: linear-gradient(135deg, rgba(39, 174, 96, 0.15) 0%, rgba(46, 204, 113, 0.15) 100%);
            color: #27ae60;
            border-left: 4px solid #2ecc71;
        }

        .reset-body .alert-danger {
            background: rgba(220, 53, 69, 0.08);
            color: #c0392b;
            border-left: 4px solid #e74c3c;
        }

        .reset-body .lc-input-group {
            margin-bottom: 20px;
        }

        .reset-body .lc-input-group label {
            display: block;
            font-size: 14px;
            font-weight: 600;
            color: #333;
            margin-bottom: 8px;
        }

        .reset-body .lc-input-group input {
            width: 100%;
            padding: 12px 16px;
            border: 1.5px solid #e0e0e0;
            border-radius: 10px;
            font-size: 15px;
            color: #333;
            background: #fafafa;
            transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
            outline: none;
        }

        .reset-body .lc-input-group input:focus {
            border-color: #ff5e14;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(255, 94, 20, 0.12);
        }

        .reset-body .lc-btn {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #ff5e14 0%, #ff8e14 100%);
            color: #fff !important;
            border: none;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
            box-shadow: 0 6px 20px rgba(255, 94, 20, 0.35);
            margin-bottom: 16px;
        }

        .reset-body .lc-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(255, 94, 20, 0.45);
            color: #fff !important;
        }

        .reset-body .lc-back {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            color: #ff5e14;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
        }

        .reset-body .lc-back:hover { color: #e5550f; }
    </style>
</head>
<body>
    <div class="reset-card">
        <div class="reset-header">
            <a href="{{ path('front_home') }}" class="logo-link">
                <img src="{{ asset('assets/images/logo.png') }}" alt="EducaVision">
            </a>
            <div class="icon-box">
                <i class="fa fa-lock-open"></i>
            </div>
            <h1>Nouveau mot de passe</h1>
            <p>Choisissez un mot de passe sécurisé</p>
        </div>

        <div class="reset-body">
            {% if success %}
                <div class="alert alert-success">
                    <i class="fa fa-check-circle" style="margin-right: 8px;"></i>
                    {{ success }}
                </div>
                <a href="{{ path('app_login') }}" class="lc-btn" style="display: block; text-align: center; text-decoration: none;">
                    <i class="fa fa-sign-in-alt" style="margin-right: 8px;"></i>Se connecter
                </a>
            {% else %}
                {% if error %}
                    <div class="alert alert-danger">
                        <i class="fa fa-exclamation-circle" style="margin-right: 8px;"></i>
                        {{ error }}
                    </div>
                    {% if 'invalide' in error|lower or 'expiré' in error|lower %}
                        <a href="{{ path('app_forgot_password_request') }}" class="lc-btn" style="display: block; text-align: center; text-decoration: none; margin-bottom: 16px;">
                            <i class="fa fa-envelope" style="margin-right: 8px;"></i>Demander un nouveau lien
                        </a>
                    {% else %}
                <form method="post">
                    <div class="lc-input-group">
                        <label for="password"><i class="fa fa-key" style="margin-right: 6px; color: #ff5e14;"></i>Nouveau mot de passe</label>
                        <input type="password" id="password" name="password" required
                               placeholder="••••••••" autocomplete="new-password">
                    </div>
                    <div class="lc-input-group">
                        <label for="password_confirm"><i class="fa fa-check-double" style="margin-right: 6px; color: #ff5e14;"></i>Confirmer le mot de passe</label>
                        <input type="password" id="password_confirm" name="password_confirm" required
                               placeholder="••••••••" autocomplete="new-password">
                    </div>
                    <button type="submit" class="lc-btn">
                        <i class="fa fa-save" style="margin-right: 8px;"></i>Réinitialiser le mot de passe
                    </button>
                </form>
                    {% endif %}
                {% else %}
                <form method="post">
                    <div class="lc-input-group">
                        <label for="password"><i class="fa fa-key" style="margin-right: 6px; color: #ff5e14;"></i>Nouveau mot de passe</label>
                        <input type="password" id="password" name="password" required
                               placeholder="••••••••" autocomplete="new-password">
                    </div>
                    <div class="lc-input-group">
                        <label for="password_confirm"><i class="fa fa-check-double" style="margin-right: 6px; color: #ff5e14;"></i>Confirmer le mot de passe</label>
                        <input type="password" id="password_confirm" name="password_confirm" required
                               placeholder="••••••••" autocomplete="new-password">
                    </div>
                    <button type="submit" class="lc-btn">
                        <i class="fa fa-save" style="margin-right: 8px;"></i>Réinitialiser le mot de passe
                    </button>
                </form>
                {% endif %}
            {% endif %}

            <a href="{{ path('app_login') }}" class="lc-back">
                <i class="fa fa-arrow-left"></i> Retour à la connexion
            </a>
        </div>
    </div>
</body>
</html>

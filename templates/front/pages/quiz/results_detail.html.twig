{% extends 'front/base.html.twig' %}

{% block title %}Détails des résultats - {{ quiz.titre }}{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="{{ asset('front-assets/css/quiz.css') }}?v={{ random() }}">
    <link rel="stylesheet" href="{{ asset('front-assets/css/quiz-animations.css') }}?v={{ random() }}">
    <link rel="stylesheet" href="{{ asset('front-assets/css/quiz-enhanced.css') }}?v={{ random() }}">
{% endblock %}

{% block body %}
<!-- Page Banner -->
<div class="quiz-banner">
    <div class="container">
        <div class="quiz-banner-content">
            <h1>Détails des résultats</h1>
            <p>{{ quiz.titre }}</p>
        </div>
    </div>
</div>

<!-- Breadcrumb -->
<div class="breadcrumb-row">
    <div class="container">
        <ul class="list-inline">
            <li><a href="{{ path('front_home') }}">Accueil</a></li>
            <li><a href="{{ path('quiz_index') }}">Quiz</a></li>
            <li><a href="{{ path('quiz_take', {'id': quiz.idquiz}) }}">{{ quiz.titre }}</a></li>
            <li>Détails</li>
        </ul>
    </div>
</div>

<!-- Content -->
<div class="content-block">
    <div class="section-area section-sp2">
        <div class="container">
            <div class="quiz-take-container">
                <div class="quiz-info-box">
                    <h5 class="mb-4">{{ quiz.titre }}</h5>
                    <div class="row">
                        <div class="col-md-4">
                            <strong><i class="fas fa-star"></i> Score:</strong> {{ result.score }}
                        </div>
                        <div class="col-md-4">
                            <strong><i class="fas fa-calendar"></i> Date:</strong> {{ result.datepassage|date('d/m/Y H:i') }}
                        </div>
                        <div class="col-md-4">
                            <strong><i class="fas fa-user"></i> Utilisateur:</strong> {{ result.utilisateur }}
                        </div>
                    </div>
                </div>

                <div class="quiz-question-card text-center">
                    <div class="quiz-empty-icon mx-auto mb-4">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <h3 class="quiz-empty-title mb-4">Merci d'avoir complété ce quiz d'orientation!</h3>
                    <p class="quiz-empty-message mb-4">Votre participation a été enregistrée avec succès.</p>
                    
                    <div class="quiz-actions justify-content-center">
                        <a href="{{ path('quiz_take', {'id': quiz.idquiz}) }}" class="quiz-btn quiz-btn-primary">
                            <i class="fas fa-redo"></i>
                            <span>Refaire le quiz</span>
                        </a>
                        <a href="{{ path('quiz_index') }}" class="quiz-btn quiz-btn-secondary">
                            <i class="fas fa-list"></i>
                            <span>Voir autres quiz</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

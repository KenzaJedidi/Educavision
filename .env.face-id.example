# Face ID Configuration
# Copy these to your .env file

# Face ID API Configuration (for external API integration)
FACE_ID_API_ENDPOINT=https://api.faceid.example.com
FACE_ID_API_KEY=your-api-key-here

# JWT Secret for token signing (generate a secure random string)
# You can generate one with: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

    <!-- JavaScript pour Face ID -->
    <script src="{{ asset('assets/js/jquery.min.js') }}"></script>
    <script src="{{ asset('assets/vendors/bootstrap/js/popper.min.js') }}"></script>
    <script src="{{ asset('assets/vendors/bootstrap/js/bootstrap.min.js') }}"></script>
    <script src="{{ asset('assets/js/functions.js') }}"></script>

    <script>
        let stream = null;
        let canvas = null;
        let isCameraActive = false;
        let photoCaptured = false;

        const cameraZone = document.getElementById('cameraZone');
        const cameraPlaceholder = document.getElementById('cameraPlaceholder');
        const cameraPreview = document.getElementById('cameraPreview');
        const cameraOverlay = document.getElementById('cameraOverlay');
        const scanningLine = document.getElementById('scanningLine');
        const btnCapture = document.getElementById('btnCapture');
        const btnFaceIdAuth = document.getElementById('btnFaceIdAuth');
        const btnRetake = document.getElementById('btnRetake');
        const faceIdEmail = document.getElementById('faceIdEmail');
        const faceIdError = document.getElementById('faceIdError');
        const faceIdErrorText = document.getElementById('faceIdErrorText');
        const faceIdSuccess = document.getElementById('faceIdSuccess');
        const faceIdSuccessText = document.getElementById('faceIdSuccessText');

        // Click on camera zone to start camera
        cameraZone.addEventListener('click', async () => {
            if (!isCameraActive && !photoCaptured) {
                await startCamera();
            }
        });

        // Start camera
        async function startCamera() {
            try {
                stream = await navigator.mediaDevices.getUserMedia({ 
                    video: { facingMode: 'user', width: 640, height: 480 },
                    audio: false 
                });
                cameraPreview.srcObject = stream;
                cameraPreview.style.display = 'block';
                cameraPlaceholder.style.display = 'none';
                cameraOverlay.style.display = 'block';
                scanningLine.style.display = 'block';
                cameraZone.classList.add('active');
                btnCapture.style.display = 'flex';
                isCameraActive = true;
                hideError();
            } catch (err) {
                showError('Impossible d\'acceder a la camera: ' + err.message);
            }
        }

        // Capture photo
        btnCapture.addEventListener('click', () => {
            if (isCameraActive) {
                capturePhoto();
            }
        });

        function capturePhoto() {
            canvas = document.getElementById('faceCanvas');
            canvas.width = cameraPreview.videoWidth;
            canvas.height = cameraPreview.videoHeight;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(cameraPreview, 0, 0);
            
            // Stop camera
            stream.getTracks().forEach(track => track.stop());
            
            // Show captured image
            cameraPreview.style.display = 'none';
            cameraOverlay.style.display = 'none';
            scanningLine.style.display = 'none';
            
            // Create and show snapshot
            const snapshot = canvas.toDataURL('image/jpeg');
            cameraZone.style.backgroundImage = `url(${snapshot})`;
            cameraZone.style.backgroundSize = 'cover';
            cameraZone.style.backgroundPosition = 'center';
            cameraZone.classList.remove('active');
            cameraZone.classList.add('captured');
            
            // Update buttons
            btnCapture.style.display = 'none';
            btnFaceIdAuth.style.display = 'flex';
            btnRetake.style.display = 'flex';
            
            isCameraActive = false;
            photoCaptured = true;
            
            showSuccess('Photo capturee avec succes');
        }

        // Retake photo
        btnRetake.addEventListener('click', async () => {
            cameraZone.style.backgroundImage = '';
            cameraZone.classList.remove('captured');
            cameraPlaceholder.style.display = 'flex';
            btnFaceIdAuth.style.display = 'none';
            btnRetake.style.display = 'none';
            photoCaptured = false;
            canvas = null;
            hideSuccess();
            hideError();
            await startCamera();
        });

        // Authenticate with Face ID
        btnFaceIdAuth.addEventListener('click', async () => {
            const email = faceIdEmail.value.trim();

            if (!email) {
                showError('Veuillez entrer votre email');
                return;
            }

            if (!canvas) {
                showError('Veuillez d\'abord capturer une photo de votre visage');
                return;
            }

            btnFaceIdAuth.disabled = true;
            const btnText = document.getElementById('btnFaceIdAuthText');
            const originalText = btnText.textContent;
            btnText.innerHTML = '<span class="spinner"></span> Authentification...';

            try {
                const imageBase64 = canvas.toDataURL('image/jpeg').split(',')[1];

                const response = await fetch('{{ path('app_login_face_id') }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: 'email=' + encodeURIComponent(email) + '&face_image=' + encodeURIComponent(imageBase64)
                });

                const data = await response.json();

                if (data.success) {
                    hideError();
                    
                    // Store JWT token in localStorage
                    if (data.jwt) {
                        localStorage.setItem('jwt_token', data.jwt);
                        localStorage.setItem('jwt_expires_at', Date.now() + (data.expires_in * 1000));
                        localStorage.setItem('jwt_user', JSON.stringify(data.user));
                        console.log('JWT Token stored successfully');
                    }
                    
                    showSuccess('Authentification reussie! Bienvenue ' + data.user.name + ' ! Redirection...');
                    
                    setTimeout(() => {
                        window.location.href = data.redirect;
                    }, 1500);
                } else {
                    showError(data.error || 'Authentification echouee');
                    btnFaceIdAuth.disabled = false;
                    btnText.textContent = originalText;
                }

            } catch (err) {
                showError('Erreur lors de l\'authentification: ' + err.message);
                btnFaceIdAuth.disabled = false;
                btnText.textContent = originalText;
            }
        });

        // Helper function to get JWT token for API requests
        function getJwtToken() {
            const expiresAt = localStorage.getItem('jwt_expires_at');
            if (expiresAt && Date.now() > parseInt(expiresAt)) {
                // Token expired, clear storage
                localStorage.removeItem('jwt_token');
                localStorage.removeItem('jwt_expires_at');
                localStorage.removeItem('jwt_user');
                return null;
            }
            return localStorage.getItem('jwt_token');
        }

        // Helper function to make authenticated API requests
        async function apiRequest(url, options = {}) {
            const token = getJwtToken();
            if (token) {
                options.headers = options.headers || {};
                options.headers['Authorization'] = 'Bearer ' + token;
            }
            return fetch(url, options);
        }

        function showError(message) {
            faceIdErrorText.textContent = message;
            faceIdError.style.display = 'flex';
            faceIdSuccess.style.display = 'none';
        }

        function hideError() {
            faceIdError.style.display = 'none';
        }

        function showSuccess(message) {
            faceIdSuccessText.textContent = message;
            faceIdSuccess.style.display = 'flex';
            faceIdError.style.display = 'none';
        }

        function hideSuccess() {
            faceIdSuccess.style.display = 'none';
        }

        // ═══════════ COMPACT CARD: Tab switching ═══════════
        function switchTab(tab, btn) {
            document.querySelectorAll('.lc-tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.lc-panel').forEach(p => p.classList.remove('active'));
            btn.classList.add('active');
            document.getElementById('panel-' + tab).classList.add('active');
        }

        // ═══════════ COMPACT CARD: Face ID logic ═══════════
        (function() {
            const lcCameraZone = document.getElementById('lc-cameraZone');
            if (!lcCameraZone) return;

            const lcPlaceholder = document.getElementById('lc-cameraPlaceholder');
            const lcPreview     = document.getElementById('lc-cameraPreview');
            const lcCanvas      = document.getElementById('lc-faceCanvas');
            const lcBtnCapture  = document.getElementById('lc-btnCapture');
            const lcBtnAuth     = document.getElementById('lc-btnAuth');
            const lcBtnRetake   = document.getElementById('lc-btnRetake');
            const lcFidEmail    = document.getElementById('lc-fid-email');
            const lcErrBox      = document.getElementById('lc-faceError');
            const lcErrText     = document.getElementById('lc-faceErrorText');
            const lcOkBox       = document.getElementById('lc-faceSuccess');
            const lcOkText      = document.getElementById('lc-faceSuccessText');

            let lcStream = null, lcPhoto = null, lcCameraOn = false;

            function lcShowErr(msg) { lcErrText.textContent = msg; lcErrBox.style.display = 'flex'; lcOkBox.style.display = 'none'; }
            function lcShowOk(msg)  { lcOkText.textContent  = msg; lcOkBox.style.display  = 'flex'; lcErrBox.style.display = 'none'; }

            lcCameraZone.addEventListener('click', async () => {
                if (!lcCameraOn && !lcPhoto) await lcStartCamera();
            });

            async function lcStartCamera() {
                try {
                    lcStream = await navigator.mediaDevices.getUserMedia({ video: { facingMode: 'user' }, audio: false });
                    lcPreview.srcObject = lcStream;
                    lcPreview.style.display = 'block';
                    lcPlaceholder.style.display = 'none';
                    lcCameraZone.classList.add('active');
                    lcBtnCapture.style.display = 'flex';
                    lcCameraOn = true;
                } catch(e) { lcShowErr('Impossible d\'accéder à la caméra: ' + e.message); }
            }

            lcBtnCapture.addEventListener('click', () => {
                lcCanvas.width  = lcPreview.videoWidth;
                lcCanvas.height = lcPreview.videoHeight;
                lcCanvas.getContext('2d').drawImage(lcPreview, 0, 0);
                lcStream.getTracks().forEach(t => t.stop());
                lcPreview.style.display = 'none';
                const snap = lcCanvas.toDataURL('image/jpeg');
                lcCameraZone.style.cssText += `;background-image:url(${snap});background-size:cover;background-position:center;`;
                lcCameraZone.classList.remove('active');
                lcCameraZone.classList.add('captured');
                lcBtnCapture.style.display = 'none';
                lcBtnAuth.style.display    = 'flex';
                lcBtnRetake.style.display  = 'flex';
                lcCameraOn = false; lcPhoto = lcCanvas;
                lcShowOk('Photo capturée ✓');
            });

            lcBtnRetake.addEventListener('click', async () => {
                lcCameraZone.style.backgroundImage = '';
                lcCameraZone.classList.remove('captured');
                lcPlaceholder.style.display = 'flex';
                lcBtnAuth.style.display   = 'none';
                lcBtnRetake.style.display = 'none';
                lcPhoto = null;
                lcOkBox.style.display = 'none';
                await lcStartCamera();
            });

            lcBtnAuth.addEventListener('click', async () => {
                const email = lcFidEmail.value.trim();
                if (!email) { lcShowErr('Veuillez entrer votre email'); return; }
                if (!lcPhoto) { lcShowErr('Veuillez capturer une photo'); return; }

                lcBtnAuth.disabled = true;
                const span = document.getElementById('lc-authText');
                span.innerHTML = '<span style="display:inline-block;width:14px;height:14px;border:2px solid rgba(255,255,255,.4);border-top-color:#fff;border-radius:50%;animation:spin 1s linear infinite;vertical-align:middle;"></span> Authentification...';

                try {
                    const b64 = lcCanvas.toDataURL('image/jpeg').split(',')[1];
                    const res = await fetch('{{ path('app_login_face_id') }}', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                        body: 'email=' + encodeURIComponent(email) + '&face_image=' + encodeURIComponent(b64)
                    });
                    const data = await res.json();
                    if (data.success) {
                        if (data.jwt) {
                            localStorage.setItem('jwt_token', data.jwt);
                            localStorage.setItem('jwt_expires_at', Date.now() + data.expires_in * 1000);
                        }
                        lcShowOk('Authentifié ! Redirection...');
                        setTimeout(() => window.location.href = data.redirect, 1200);
                    } else {
                        lcShowErr(data.error || 'Authentification échouée');
                        lcBtnAuth.disabled = false;
                        span.textContent = 'S\'authentifier';
                    }
                } catch(e) {
                    lcShowErr('Erreur: ' + e.message);
                    lcBtnAuth.disabled = false;
                    span.textContent = 'S\'authentifier';
                }
            });
        })();
    </script>

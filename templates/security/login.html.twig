        /* Face scan animation */
        .scanning-line {
            position: absolute;
            left: 10%;
            width: 80%;
            height: 3px;
            background: linear-gradient(90deg, transparent, #00f2fe, transparent);
            border-radius: 2px;
            display: none;
            animation: scanning 2s ease-in-out infinite;
        }

        @keyframes scanning {
            0% { top: 10%; opacity: 0; }
            10% { opacity: 1; }
            90% { opacity: 1; }
            100% { top: 90%; opacity: 0; }
        }
        /* ============================================
           RESPONSIVE REDESIGN — Clean card layout
           ============================================ */

        html, body { box-sizing: border-box; }
        *, *::before, *::after { box-sizing: inherit; }

        /* ── Full-screen (≥ 992px): original split layout ── */
        @media (min-width: 992px) {
            .account-form       { min-height: 100vh; }
            .account-form-inner { overflow-y: auto; max-height: 100vh; }
            /* Hide the compact card — show regular content */
            .login-compact-card { display: none !important; }
            /* Show original account-form markup */
            .account-head,
            .account-form-inner { display: flex; }
        }

        /* ── Windowed (< 992px): centered card, tab-based ── */
        @media (max-width: 991px) {
            /* Hide the original side-by-side layout */
            .account-form { display: none !important; }

            /* Full page gradient bg */
            body {
                background: linear-gradient(135deg, #1a1a2e 0%, #16213e 40%, #0f3460 100%);
                min-height: 100vh;
                display: flex;
                align-items: flex-start;
                justify-content: center;
                padding: 0;
            }

            /* Centered card */
            .login-compact-card {
                display: flex;
                flex-direction: column;
                width: 100%;
                max-width: 440px;
                min-height: 100vh;
                margin: 0 auto;
                background: #fff;
                border-radius: 0;
                overflow: hidden;
                box-shadow: 0 30px 80px rgba(0,0,0,0.4);
            }
        }

        /* ── Wider windowed but still < 992px ── */
        @media (min-width: 640px) and (max-width: 991px) {
            body {
                padding: 30px 20px;
                align-items: center;
            }
            .login-compact-card {
                min-height: auto;
                border-radius: 24px;
                max-width: 480px;
            }
        }

        /* Compact card header */
        .login-compact-card .lc-header {
            background: linear-gradient(135deg, #ff5e14, #ff8e14);
            padding: 28px 32px 24px;
            text-align: center;
        }
        .login-compact-card .lc-header img {
            height: 52px;
            width: auto;
        }
        .login-compact-card .lc-header p {
            color: rgba(255,255,255,0.85);
            font-size: 13px;
            margin: 8px 0 0;
            letter-spacing: 0.5px;
        }

        /* Tab switcher */
        .login-compact-card .lc-tabs {
            display: flex;
            border-bottom: 2px solid #f0f0f0;
        }
        .login-compact-card .lc-tab {
            flex: 1;
            padding: 14px 10px;
            text-align: center;
            font-size: 14px;
            font-weight: 600;
            color: #999;
            cursor: pointer;
            border-bottom: 3px solid transparent;
            margin-bottom: -2px;
            transition: all 0.25s;
            background: none;
            border-top: none;
            border-left: none;
            border-right: none;
        }
        .login-compact-card .lc-tab.active {
            color: #ff5e14;
            border-bottom-color: #ff5e14;
        }
        .login-compact-card .lc-tab i {
            margin-right: 6px;
        }

        /* Tab panels */
        .login-compact-card .lc-panel {
            display: none;
            padding: 24px 28px 32px;
            flex: 1;
        }
        .login-compact-card .lc-panel.active { display: block; }

        /* Compact form inside card */
        .lc-panel .lc-title {
            font-size: 20px;
            font-weight: 700;
            color: #1a1a2e;
            margin: 0 0 4px;
        }
        .lc-panel .lc-subtitle {
            font-size: 13px;
            color: #888;
            margin: 0 0 20px;
        }
        .lc-panel .lc-subtitle a {
            color: #ff5e14;
            text-decoration: none;
            font-weight: 600;
        }

        /* Flash / error inside card */
        .lc-panel .alert {
            padding: 10px 14px;
            border-radius: 8px;
            font-size: 13px;
            margin-bottom: 16px;
            border: none;
        }
        .lc-panel .alert-danger { background: #fff0f0; color: #c0392b; border-left: 3px solid #e74c3c; }
        .lc-panel .alert-success { background: #f0fff4; color: #27ae60; border-left: 3px solid #2ecc71; }

        /* Inputs inside card */
        .lc-panel .lc-input-group {
            margin-bottom: 14px;
        }
        .lc-panel .lc-input-group label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #444;
            margin-bottom: 5px;
        }
        .lc-panel .lc-input-group input {
            width: 100%;
            padding: 12px 16px;
            border: 1.5px solid #e0e0e0;
            border-radius: 10px;
            font-size: 14px;
            color: #333;
            background: #fafafa;
            transition: border-color 0.2s, box-shadow 0.2s;
            outline: none;
        }
        .lc-panel .lc-input-group input:focus {
            border-color: #ff5e14;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(255,94,20,0.12);
        }

        /* Remember / forgot row */
        .lc-panel .lc-meta {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 18px;
            font-size: 13px;
        }
        .lc-panel .lc-meta label { color: #666; cursor: pointer; }
        .lc-panel .lc-meta a { color: #ff5e14; text-decoration: none; font-weight: 500; }

        /* Submit button */
        .lc-panel .lc-btn {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #ff5e14, #ff8e14);
            color: #fff;
            border: none;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
            box-shadow: 0 6px 20px rgba(255,94,20,0.35);
        }
        .lc-panel .lc-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(255,94,20,0.45);
        }

        /* ---- Face ID tab (compact) ---- */
        .lc-panel .lc-faceid-header {
            text-align: center;
            margin-bottom: 18px;
        }
        .lc-panel .lc-faceid-header .lc-fid-icon {
            width: 64px; height: 64px;
            background: linear-gradient(135deg, #4facfe, #00f2fe);
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 12px;
            box-shadow: 0 8px 24px rgba(79,172,254,0.45);
            animation: pulse-glow 2s ease-in-out infinite;
        }
        .lc-panel .lc-faceid-header .lc-fid-icon i { font-size: 28px; color: #fff; }
        .lc-panel .lc-faceid-header h4 { font-size: 17px; font-weight: 700; color: #1a1a2e; margin:0 0 4px; }
        .lc-panel .lc-faceid-header p { font-size: 12px; color: #888; margin: 0; }

        /* Compact camera zone */
        .lc-fid-camera {
            position: relative;
            width: 100%;
            aspect-ratio: 4/3;
            max-height: 200px;
            border-radius: 12px;
            overflow: hidden;
            background: linear-gradient(135deg, #0f0c29, #24243e);
            border: 2px dashed rgba(79,172,254,0.5);
            cursor: pointer;
            transition: all 0.3s;
            margin-bottom: 14px;
        }
        .lc-fid-camera:hover { border-color: #4facfe; }
        .lc-fid-camera.active { border-style: solid; border-color: #00f2fe; }
        .lc-fid-camera.captured { border-color: #00d084; }

        .lc-fid-placeholder {
            position: absolute; inset: 0;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            color: rgba(255,255,255,0.85);
        }
        .lc-fid-placeholder i { font-size: 32px; color: #4facfe; margin-bottom: 8px; }
        .lc-fid-placeholder span { font-size: 13px; }

        .lc-fid-btn {
            width: 100%; padding: 12px;
            border: none; border-radius: 10px;
            font-size: 14px; font-weight: 700;
            cursor: pointer; display: none;
            align-items: center; justify-content: center; gap: 8px;
            transition: all 0.25s;
            margin-bottom: 10px;
        }
        .lc-fid-btn.capture-btn {
            background: linear-gradient(135deg, #4facfe, #00f2fe); color: #fff;
        }
        .lc-fid-btn.auth-btn {
            background: linear-gradient(135deg, #00d084, #00f260); color: #fff;
        }
        .lc-fid-btn.retake-btn {
            background: rgba(0,0,0,0.07); color: #555;
            border: 1.5px solid #ddd;
        }
        .lc-fid-btn:hover { transform: translateY(-2px); }

        .lc-fid-msg {
            padding: 10px 14px; border-radius: 8px; font-size: 13px;
            display: none; align-items: center; gap: 8px; margin-top: 10px;
        }
        .lc-fid-msg.error { background: rgba(220,53,69,0.1); color: #c0392b; border-left: 3px solid #e74c3c; }
        .lc-fid-msg.success { background: rgba(0,208,132,0.1); color: #27ae60; border-left: 3px solid #2ecc71; }
    </style>
</head>
<body>
    {# ═══════════════════════════════════════════════
       COMPACT CARD LAYOUT (< 992px only, via CSS)
    ═══════════════════════════════════════════════ #}
    <div class="login-compact-card">
        {# Header banner #}
        <div class="lc-header">
            <a href="{{ path('front_home') }}">
                <img src="{{ asset('assets/images/logo-white-2.png') }}" alt="EducaVision">
            </a>
            <p>Plateforme d'apprentissage en ligne</p>
        </div>

        {# Tab switcher #}
        <div class="lc-tabs">
            <button class="lc-tab active" onclick="switchTab('password', this)" id="tab-password-btn">
                <i class="fa fa-lock"></i> Mot de passe
            </button>
            <button class="lc-tab" onclick="switchTab('faceid', this)" id="tab-faceid-btn">
                <i class="fa fa-user-shield"></i> Face ID
            </button>
        </div>

        {# Password tab #}
        <div class="lc-panel active" id="panel-password">
            <h2 class="lc-title">Connexion</h2>
            <p class="lc-subtitle">Pas encore de compte ? <a href="{{ path('app_register') }}">Créer un compte</a></p>

            {% if error %}
                <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}

            <form method="post">
                <div class="lc-input-group">
                    <label for="lc-email">Email</label>
                    <input type="email" id="lc-email" name="_username" value="{{ last_username }}"
                           autocomplete="email" required autofocus placeholder="votre@email.com">
                </div>
                <div class="lc-input-group">
                    <label for="lc-password">Mot de passe</label>
                    <input type="password" id="lc-password" name="_password"
                           autocomplete="current-password" required placeholder="••••••••">
                </div>
                <div class="lc-meta">
                    <label>
                        <input type="checkbox" name="_remember_me" style="margin-right:5px;">
                        Se souvenir de moi
                    </label>
                    <a href="{{ path('app_forgot_password_request') }}">Mot de passe oublié ?</a>
                </div>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button type="submit" class="lc-btn">Se connecter</button>
            </form>
        </div>

        {# Face ID tab #}
        <div class="lc-panel" id="panel-faceid">
            <div class="lc-faceid-header">
                <div class="lc-fid-icon"><i class="fa fa-user-shield"></i></div>
                <h4>Connexion Face ID</h4>
                <p>Authentification biométrique rapide et sécurisée</p>
            </div>

            <div class="lc-input-group">
                <label for="lc-fid-email">Votre email</label>
                <input type="email" id="lc-fid-email" placeholder="votre@email.com">
            </div>

            <div class="lc-fid-camera" id="lc-cameraZone">
                <div class="lc-fid-placeholder" id="lc-cameraPlaceholder">
                    <i class="fa fa-camera"></i>
                    <span>Cliquez pour activer la caméra</span>
                </div>
                <video id="lc-cameraPreview" style="width:100%;height:100%;object-fit:cover;display:none;border-radius:10px;" autoplay playsinline></video>
                <canvas id="lc-faceCanvas" style="display:none;"></canvas>
            </div>

            <button class="lc-fid-btn capture-btn" id="lc-btnCapture"><i class="fa fa-camera"></i> Capturer</button>
            <button class="lc-fid-btn auth-btn" id="lc-btnAuth"><i class="fa fa-check-circle"></i> <span id="lc-authText">S'authentifier</span></button>
            <button class="lc-fid-btn retake-btn" id="lc-btnRetake"><i class="fa fa-redo"></i> Reprendre</button>

            <div class="lc-fid-msg error" id="lc-faceError"><i class="fa fa-exclamation-circle"></i><span id="lc-faceErrorText"></span></div>
            <div class="lc-fid-msg success" id="lc-faceSuccess"><i class="fa fa-check-circle"></i><span id="lc-faceSuccessText"></span></div>
        </div>
    </div>


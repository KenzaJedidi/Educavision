# =============================================================================
# Configuration Mailer + SMTP - Récupération mot de passe EducaVision
# =============================================================================
# Copiez ces variables dans votre fichier .env ou .env.local
# Ne commitez JAMAIS .env.local avec vos identifiants réels
# =============================================================================

###> symfony/mailer ###

# --- Option 1 : Développement local (MailHog / Mailpit)
# Les emails sont capturés localement, pas envoyés sur Internet
# Lancez MailHog (https://github.com/mailhog/MailHog) ou Mailpit
MAILER_DSN=smtp://localhost:1025
MAILER_FROM_ADDRESS=no-reply@educavision.com
MAILER_FROM_NAME=EducaVision

# --- Option 2 : Gmail (recommandé pour tests)
# 1. Activez la validation en 2 étapes sur votre compte Google
# 2. Créez un "Mot de passe d'application" : Google Account > Sécurité > Mots de passe des applications
# 3. Utilisez ce mot de passe ci-dessous (pas votre mot de passe habituel)
# MAILER_DSN=smtps://VOTRE_EMAIL@gmail.com:MOT_DE_PASSE_APP@smtp.gmail.com:465
# MAILER_FROM_ADDRESS=VOTRE_EMAIL@gmail.com
# MAILER_FROM_NAME=EducaVision

# --- Option 3 : Outlook / Microsoft 365
# MAILER_DSN=smtps://VOTRE_EMAIL@outlook.com:MOT_DE_PASSE@smtp-mail.outlook.com:587
# ou pour Office 365 :
# MAILER_DSN=smtps://VOTRE_EMAIL@votredomaine.com:MOT_DE_PASSE@smtp.office365.com:587
# MAILER_FROM_ADDRESS=VOTRE_EMAIL@outlook.com
# MAILER_FROM_NAME=EducaVision

# --- Option 4 : SMTP générique (hébergeur, OVH, etc.)
# Format : smtp://[user:password@]host[:port]
# MAILER_DSN=smtp://user:password@smtp.votredomaine.com:587
# MAILER_FROM_ADDRESS=noreply@votredomaine.com
# MAILER_FROM_NAME=EducaVision

# --- Option 5 : Brevo (ex-Sendinblue) - gratuit jusqu'à 300 emails/jour
# Compte sur https://www.brevo.com
# MAILER_DSN=smtp://VOTRE_LOGIN:VOTRE_MOT_DE_PASSE@smtp-relay.brevo.com:587
# MAILER_FROM_ADDRESS=no-reply@votredomaine.com
# MAILER_FROM_NAME=EducaVision

###< symfony/mailer ###

# URL de base du site (pour les liens dans les emails)
# Important : doit pointer vers votre domaine en production
# APP_URL=https://www.educavision.com

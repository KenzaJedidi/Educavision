# Variables d'environnement pour le module Cours
# Copiez ces lignes dans votre fichier .env

# Clé API Unsplash (obligatoire pour les fonctionnalités d'images)
# 1. Créez un compte sur https://unsplash.com/join
# 2. Allez dans https://unsplash.com/developers
# 3. Créez une nouvelle application
# 4. Copiez la "Access Key" ci-dessous
UNSPLASH_ACCESS_KEY=votre_clé_access_unsplash

# Langue Wikipedia (optionnel, par défaut: fr)
WIKIPEDIA_LANGUAGE=fr

# Configuration des uploads (optionnel)
COURSE_MAX_FILE_SIZE=20M
COURSE_IMAGES_DIR=uploads/courses/images
COURSE_PDF_DIR=uploads/courses/pdf

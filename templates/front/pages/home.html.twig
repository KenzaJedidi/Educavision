{% extends 'front/base.html.twig' %}

{% block title %}Accueil - EducaVision{% endblock %}

{% block body_class %}page-home{% endblock %}

{% block stylesheets %}
    {{ parent() }}
{% endblock %}

{% block body %}
<!-- Bannière compacte -->
<div class="home-hero">
    <div class="home-hero-bg" style="background-image: url('{{ asset('front-assets/images/slider/slide1.jpg') }}');"></div>
    <div class="home-hero-overlay"></div>
    <div class="home-hero-content">
        <h1>Bienvenue sur EducaVision</h1>
        <p class="home-hero-subtitle">Meilleure éducation pour un meilleur avenir</p>
        <p class="home-hero-desc">Plateforme intelligente d'apprentissage et de suivi pédagogique</p>
        <div class="home-hero-buttons">
            <a href="{{ path('front_cours_list') }}" class="home-hero-btn home-hero-btn-primary">NOS COURS</a>
            <a href="{{ path('front_contact') }}" class="home-hero-btn home-hero-btn-secondary">CONTACTEZ-NOUS</a>
        </div>
    </div>
</div>

<!-- Services -->
<div class="section-area content-inner service-info-bx">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 col-md-4 col-sm-6">
                <div class="service-bx">
                    <div class="action-box">
                        <img src="{{ asset('front-assets/images/our-services/pic1.jpg') }}" alt="">
                    </div>
                    <div class="info-bx text-center">
                        <div class="feature-box-sm radius bg-white">
                            <i class="fa fa-graduation-cap text-primary"></i>
                        </div>
                        <h4><a href="{{ path('front_filieres') }}">Filières d'Excellence</a></h4>
                        <a href="{{ path('front_filieres') }}" class="btn radius-xl">Découvrir</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-4 col-sm-6">
                <div class="service-bx">
                    <div class="action-box">
                        <img src="{{ asset('front-assets/images/our-services/pic2.jpg') }}" alt="">
                    </div>
                    <div class="info-bx text-center">
                        <div class="feature-box-sm radius bg-white">
                            <i class="fa fa-book text-primary"></i>
                        </div>
                        <h4><a href="{{ path('front_cours_list') }}">Cours en Ligne</a></h4>
                        <a href="{{ path('front_cours_list') }}" class="btn radius-xl">Explorer</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-4 col-sm-12">
                <div class="service-bx m-b0">
                    <div class="action-box">
                        <img src="{{ asset('front-assets/images/our-services/pic3.jpg') }}" alt="">
                    </div>
                    <div class="info-bx text-center">
                        <div class="feature-box-sm radius bg-white">
                            <i class="fa fa-briefcase text-primary"></i>
                        </div>
                        <h4><a href="{{ path('front_stages') }}">Offres de Stages</a></h4>
                        <a href="{{ path('front_stages') }}" class="btn radius-xl">Postuler</a>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Nouvelle ligne pour Quiz et autres modules -->
        <div class="row m-t30">
            <div class="col-lg-4 col-md-4 col-sm-6">
                <div class="service-bx">
                    <div class="action-box">
                        <img src="{{ asset('front-assets/images/our-services/pic1.jpg') }}" alt="">
                    </div>
                    <div class="info-bx text-center">
                        <div class="feature-box-sm radius bg-white">
                            <i class="fa fa-question-circle text-primary"></i>
                        </div>
                        <h4><a href="{{ path('quiz_index') }}">Quiz d'Orientation</a></h4>
                        <a href="{{ path('quiz_index') }}" class="btn radius-xl">Commencer</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-4 col-sm-6">
                <div class="service-bx">
                    <div class="action-box">
                        <img src="{{ asset('front-assets/images/our-services/pic2.jpg') }}" alt="">
                    </div>
                    <div class="info-bx text-center">
                        <div class="feature-box-sm radius bg-white">
                            <i class="fa fa-road text-primary"></i>
                        </div>
                        <h4><a href="{{ path('front_simulateur') }}">Simulateur d'Orientation</a></h4>
                        <a href="{{ path('front_simulateur') }}" class="btn radius-xl">Simuler</a>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-4 col-sm-12">
                <div class="service-bx m-b0">
                    <div class="action-box">
                        <img src="{{ asset('front-assets/images/our-services/pic3.jpg') }}" alt="">
                    </div>
                    <div class="info-bx text-center">
                        <div class="feature-box-sm radius bg-white">
                            <i class="fa fa-comments text-primary"></i>
                        </div>
                        <h4><a href="{{ path('front_contact') }}">Nous Contacter</a></h4>
                        <a href="{{ path('front_contact') }}" class="btn radius-xl">Contacter</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Call to Action -->
<div class="section-area section-sp1 ovpr-dark bg-fix online-cours"
    style="background-image:url({{ asset('front-assets/images/background/bg1.jpg') }});">
    <div class="container">
        <div class="row">
            <div class="col-md-12 text-center text-white">
                <h2>Apprenez en Ligne</h2>
                <h5>Construisez votre avenir dès aujourd'hui</h5>
                <form class="cours-search" action="{{ path('front_search') }}">
                    <div class="input-group">
                        <input type="text" class="form-control" name="q"
                            placeholder="Que voulez-vous apprendre aujourd'hui ?">
                        <div class="input-group-append">
                            <button class="btn" type="submit">Rechercher</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <div class="mw800 m-auto">
            <div class="row">
                <div class="col-md-4 col-sm-6">
                    <div class="cours-search-bx m-b30">
                        <div class="icon-box">
                            <h3><i class="ti-user"></i><span class="counter">5</span>K</h3>
                        </div>
                        <span class="cours-search-text">Plus de 5000 étudiants</span>
                    </div>
                </div>
                <div class="col-md-4 col-sm-6">
                    <div class="cours-search-bx m-b30">
                        <div class="icon-box">
                            <h3><i class="ti-book"></i><span class="counter">100</span>+</h3>
                        </div>
                        <span class="cours-search-text">Plus de 100 cours</span>
                    </div>
                </div>
                <div class="col-md-4 col-sm-12">
                    <div class="cours-search-bx m-b30">
                        <div class="icon-box">
                            <h3><i class="ti-layout-list-post"></i><span class="counter">20</span>+</h3>
                        </div>
                        <span class="cours-search-text">20+ Filières disponibles</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
{% endblock %}
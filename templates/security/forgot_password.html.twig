<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Mot de passe oublié - EducaVision</title>
    <link rel="icon" href="{{ asset('front-assets/images/favicon.ico') }}" type="image/x-icon" />
    <link rel="stylesheet" type="text/css" href="{{ asset('assets/css/assets.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('assets/css/typography.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('assets/css/shortcodes/shortcodes.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('assets/css/style.css') }}">
    <link class="skin" rel="stylesheet" type="text/css" href="{{ asset('assets/css/color/color-1.css') }}">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * { box-sizing: border-box; }
        html, body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            font-family: 'Rubik', sans-serif;
        }

        /* Fond dégradé (comme le site) */
        body {
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 40%, #0f3460 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        /* Carte centrée */
        .forgot-card {
            width: 100%;
            max-width: 460px;
            background: #fff;
            border-radius: 24px;
            overflow: hidden;
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.4);
        }

        /* En-tête avec dégradé orange (aligné page login) */
        .forgot-header {
            background: linear-gradient(135deg, #ff5e14 0%, #ff8e14 100%);
            padding: 32px 28px 28px;
            text-align: center;
        }

        .forgot-header .logo-link {
            display: inline-block;
            background: #fff;
            padding: 10px 18px;
            border-radius: 12px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
        }

        .forgot-header .logo-link img {
            height: 44px;
            width: auto;
            display: block;
        }

        .forgot-header .icon-box {
            width: 72px;
            height: 72px;
            background: rgba(255, 255, 255, 0.25);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 16px auto 12px;
        }

        .forgot-header .icon-box i {
            font-size: 32px;
            color: #fff;
        }

        .forgot-header h1 {
            color: #fff;
            font-size: 22px;
            font-weight: 700;
            margin: 0 0 6px;
        }

        .forgot-header p {
            color: rgba(255, 255, 255, 0.9);
            font-size: 14px;
            margin: 0;
        }

        /* Contenu du formulaire */
        .forgot-body {
            padding: 32px 28px 36px;
        }

        .forgot-body .lc-subtitle {
            font-size: 14px;
            color: #666;
            margin: 0 0 24px;
            line-height: 1.5;
        }

        .forgot-body .lc-subtitle a {
            color: #ff5e14;
            text-decoration: none;
            font-weight: 600;
        }

        .forgot-body .lc-subtitle a:hover {
            text-decoration: underline;
        }

        /* Alertes */
        .forgot-body .alert {
            padding: 14px 18px;
            border-radius: 12px;
            font-size: 14px;
            margin-bottom: 20px;
            border: none;
        }

        .forgot-body .alert-success {
            background: linear-gradient(135deg, rgba(39, 174, 96, 0.15) 0%, rgba(46, 204, 113, 0.15) 100%);
            color: #27ae60;
            border-left: 4px solid #2ecc71;
        }

        .forgot-body .alert-danger {
            background: rgba(220, 53, 69, 0.08);
            color: #c0392b;
            border-left: 4px solid #e74c3c;
        }

        /* Groupes de champs */
        .forgot-body .lc-input-group {
            margin-bottom: 20px;
        }

        .forgot-body .lc-input-group label {
            display: block;
            font-size: 14px;
            font-weight: 600;
            color: #333;
            margin-bottom: 8px;
        }

        .forgot-body .lc-input-group input {
            width: 100%;
            padding: 12px 16px;
            border: 1.5px solid #e0e0e0;
            border-radius: 10px;
            font-size: 15px;
            color: #333;
            background: #fafafa;
            transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
            outline: none;
        }

        .forgot-body .lc-input-group input:focus {
            border-color: #ff5e14;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(255, 94, 20, 0.12);
        }

        /* Bouton principal (identique à login) */
        .forgot-body .lc-btn {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #ff5e14 0%, #ff8e14 100%);
            color: #fff !important;
            border: none;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
            box-shadow: 0 6px 20px rgba(255, 94, 20, 0.35);
            margin-bottom: 16px;
        }

        .forgot-body .lc-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 30px rgba(255, 94, 20, 0.45);
            color: #fff !important;
        }

        /* Lien retour */
        .forgot-body .lc-back {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            color: #ff5e14;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            transition: color 0.2s;
        }

        .forgot-body .lc-back:hover {
            color: #e5550f;
        }

        .forgot-body .lc-back i {
            font-size: 12px;
        }
    </style>
</head>
<body>
    <div class="forgot-card">
        <div class="forgot-header">
            <a href="{{ path('front_home') }}" class="logo-link">
                <img src="{{ asset('assets/images/logo.png') }}" alt="EducaVision">
            </a>
            <div class="icon-box">
                <i class="fa fa-key"></i>
            </div>
            <h1>Mot de passe oublié</h1>
            <p>Réinitialisez votre mot de passe en quelques clics</p>
        </div>

        <div class="forgot-body">
            {% if success %}
                <div class="alert alert-success">
                    <i class="fa fa-check-circle" style="margin-right: 8px;"></i>
                    {{ success }}
                </div>
                <a href="{{ path('app_login') }}" class="lc-btn" style="display: block; text-align: center; text-decoration: none;">
                    <i class="fa fa-sign-in-alt" style="margin-right: 8px;"></i>Retour à la connexion
                </a>
            {% else %}
                <p class="lc-subtitle">
                    Entrez votre adresse email. Si un compte existe, vous recevrez un lien pour réinitialiser votre mot de passe.
                </p>

                {% if error %}
                    <div class="alert alert-danger">
                        <i class="fa fa-exclamation-circle" style="margin-right: 8px;"></i>{{ error }}
                    </div>
                {% endif %}

                <form method="post">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('forgot_password') }}">
                    <div class="lc-input-group">
                        <label for="email"><i class="fa fa-envelope" style="margin-right: 6px; color: #ff5e14;"></i>Adresse Email</label>
                        <input type="email" id="email" name="email" required autofocus
                               value="{{ email|default('') }}"
                               placeholder="votre@email.com" autocomplete="email">
                    </div>
                    <button type="submit" class="lc-btn">
                        <i class="fa fa-paper-plane" style="margin-right: 8px;"></i>Envoyer le lien
                    </button>
                </form>
            {% endif %}

            <a href="{{ path('app_login') }}" class="lc-back">
                <i class="fa fa-arrow-left"></i> Retour à la connexion
            </a>
        </div>
    </div>
</body>
</html>

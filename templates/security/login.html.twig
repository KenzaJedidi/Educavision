        }

        .camera-zone {
            position: relative;
            width: 100%;
            aspect-ratio: 4/3;
            max-height: 280px;
            border-radius: 16px;
            overflow: hidden;
            margin-bottom: 20px;
            background: linear-gradient(135deg, rgba(0,0,0,0.3) 0%, rgba(0,0,0,0.5) 100%);
            border: 2px dashed rgba(255,255,255,0.3);
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .camera-zone:hover {
            border-color: #4facfe;
            background: linear-gradient(135deg, rgba(79, 172, 254, 0.1) 0%, rgba(0, 242, 254, 0.1) 100%);
        }

        .camera-zone.active {
            border-style: solid;
            border-color: #00f2fe;
            box-shadow: 0 0 30px rgba(0, 242, 254, 0.3);
        }

        .camera-zone.captured {
            border-color: #00d084;
            box-shadow: 0 0 30px rgba(0, 208, 132, 0.3);
        }

        .camera-placeholder {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: rgba(255,255,255,0.8);
            transition: opacity 0.3s;
        }

        .camera-placeholder-icon {
            width: 70px;
            height: 70px;
            background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 15px;
            transition: transform 0.3s;
        }

        .camera-zone:hover .camera-placeholder-icon {
            transform: scale(1.1);
        }

        .camera-placeholder-icon i {
            font-size: 28px;
            color: #fff;
        }

        .camera-placeholder-text {
            font-size: 16px;
            font-weight: 600;
            margin-bottom: 5px;
        }

        .camera-placeholder-hint {
            font-size: 13px;
            color: rgba(255,255,255,0.5);
        }

        .camera-preview {
            width: 100%;
            height: 100%;
            object-fit: cover;

{% extends 'front/base.html.twig' %}

{% block title %}Configuration Face ID - EducaVision{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    .face-id-container {
        max-width: 800px;
        margin: 40px auto;
        padding: 0 20px;
    }

    .face-id-card {
        background: #fff;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
        overflow: hidden;
    }

    .face-id-header {
        background: linear-gradient(135deg, #0f0c29 0%, #302b63 50%, #24243e 100%);
        padding: 40px;
        text-align: center;
        color: white;
    }

    .face-id-icon {
        width: 80px;
        height: 80px;
        background: rgba(255, 255, 255, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        font-size: 36px;
    }

    .face-id-title {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 10px;
    }

    .face-id-subtitle {
        opacity: 0.8;
        font-size: 16px;
    }

    .face-id-body {
        padding: 40px;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        border-radius: 30px;
        font-weight: 600;
        margin-bottom: 20px;
    }

    .status-badge.enrolled {
        background: #e8f5e9;
        color: #2e7d32;
    }

    .status-badge.not-enrolled {
        background: #fff3e0;
        color: #ef6c00;
    }

    .camera-section {
        margin-top: 30px;
    }

    .camera-zone {
        position: relative;
        width: 100%;
        max-width: 400px;
        height: 300px;
        margin: 0 auto;
        background: #1a1a2e;
        border-radius: 16px;
        overflow: hidden;
    }

    .camera-placeholder {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #fff;
        cursor: pointer;
        transition: background 0.3s;
    }

    .camera-placeholder:hover {
        background: rgba(255, 255, 255, 0.05);
    }

    .camera-placeholder-icon {
        font-size: 48px;
        margin-bottom: 15px;
        opacity: 0.7;
    }

    .camera-preview {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: none;
    }

    .camera-overlay {
        position: absolute;
        inset: 0;
        border: 4px solid transparent;
        border-radius: 16px;
        pointer-events: none;
        transition: border-color 0.3s;
    }

    .camera-overlay.active {
        border-color: #00f2fe;
        box-shadow: inset 0 0 30px rgba(0, 242, 254, 0.2);
    }

    .btn-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 14px 30px;
        border: none;
        border-radius: 30px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        margin: 10px;
    }

    .btn-capture {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
    }

    .btn-capture:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
    }

    .btn-register {
        background: linear-gradient(135deg, #00f260 0%, #0575e6 100%);
        color: white;
        display: none;
    }

    .btn-register:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0, 242, 96, 0.4);
    }

    .btn-retake {
        background: #f5f5f5;
        color: #333;
        display: none;
    }

    .btn-remove {
        background: linear-gradient(135deg, #ff416c 0%, #ff4b2b 100%);
        color: white;
    }

    .btn-remove:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(255, 65, 108, 0.4);
    }

    .message-box {
        padding: 15px 20px;
        border-radius: 10px;
        margin-top: 20px;
        display: none;
    }

    .message-box.error {
        background: #ffebee;
        color: #c62828;
        border: 1px solid #ef9a9a;
    }

    .message-box.success {
        background: #e8f5e9;
        color: #2e7d32;
        border: 1px solid #a5d6a7;
    }

    .message-box.show {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .enrolled-info {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 30px;
    }

    .enrolled-info p {
        margin: 5px 0;
        color: #666;
    }

    .enrolled-info strong {
        color: #333;
    }

    .action-buttons {
        text-align: center;
        margin-top: 30px;
    }

    .scanning-line {
        position: absolute;
        left: 10%;
        width: 80%;
        height: 3px;
        background: linear-gradient(90deg, transparent, #00f2fe, transparent);
        border-radius: 2px;
        display: none;
        animation: scanning 2s ease-in-out infinite;
    }

    @keyframes scanning {
        0% { top: 10%; opacity: 0; }
        10% { opacity: 1; }
        90% { opacity: 1; }
        100% { top: 90%; opacity: 0; }
    }

    .spinner {
        display: inline-block;
        width: 18px;
        height: 18px;
        border: 3px solid rgba(255, 255, 255, 0.3);
        border-top: 3px solid white;
        border-radius: 50%;
        animation: spin 1s linear infinite;
    }

    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>
{% endblock %}

{% block body %}
<div class="face-id-container">
    <div class="face-id-card">
        <div class="face-id-header">
            <div class="face-id-icon">
                <i class="fas fa-user-shield"></i>
            </div>
            <h1 class="face-id-title">Configuration Face ID</h1>
            <p class="face-id-subtitle">Authentification biométrique sécurisée</p>
        </div>

        <div class="face-id-body">
            {% for label, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ label }}" style="margin-bottom: 20px; padding: 15px; border-radius: 8px; {% if label == 'success' %}background: #e8f5e9; color: #2e7d32;{% else %}background: #ffebee; color: #c62828;{% endif %}">
                        {{ message }}
                    </div>
                {% endfor %}
            {% endfor %}

            {% if utilisateur.faceIdEnrolled %}
                <div class="text-center">
                    <span class="status-badge enrolled">
                        <i class="fas fa-check-circle"></i>
                        Face ID Activé
                    </span>
                </div>

                <div class="enrolled-info">
                    <p><strong>Statut:</strong> Actif et fonctionnel</p>
                    {% if utilisateur.faceIdEnrollmentDate %}
                        <p><strong>Date d'activation:</strong> {{ utilisateur.faceIdEnrollmentDate|date('d/m/Y à H:i') }}</p>
                    {% endif %}
                    <p><strong>Email associé:</strong> {{ utilisateur.email }}</p>
                </div>

                <div class="action-buttons">
                    <p style="margin-bottom: 20px; color: #666;">
                        Vous pouvez maintenant vous connecter rapidement avec votre visage depuis la page de connexion.
                    </p>
                    <form method="post" action="{{ path('profile_face_id_remove') }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer votre Face ID ?');">
                        <button type="submit" class="btn-action btn-remove">
                            <i class="fas fa-trash-alt"></i>
                            Supprimer Face ID
                        </button>
                    </form>
                </div>

            {% else %}
                <div class="text-center">
                    <span class="status-badge not-enrolled">
                        <i class="fas fa-exclamation-circle"></i>
                        Face ID Non Configuré
                    </span>
                </div>

                <p style="text-align: center; color: #666; margin-bottom: 30px;">
                    Configurez Face ID pour vous connecter rapidement et en toute sécurité avec votre visage.
                </p>

                <div class="camera-section">
                    <div class="camera-zone" id="cameraZone">
                        <div class="camera-placeholder" id="cameraPlaceholder">
                            <div class="camera-placeholder-icon">
                                <i class="fas fa-camera"></i>
                            </div>
                            <div>Cliquez pour activer la caméra</div>
                            <div style="font-size: 12px; opacity: 0.7; margin-top: 5px;">
                                Positionnez votre visage dans le cadre
                            </div>
                        </div>
                        <video id="cameraPreview" class="camera-preview" autoplay playsinline></video>
                        <canvas id="faceCanvas" style="display: none;"></canvas>
                        <div class="camera-overlay" id="cameraOverlay"></div>
                        <div class="scanning-line" id="scanningLine"></div>
                    </div>
                </div>

                <div class="action-buttons">
                    <button type="button" class="btn-action btn-capture" id="btnCapture">
                        <i class="fas fa-camera"></i>
                        <span>Capturer le visage</span>
                    </button>

                    <button type="button" class="btn-action btn-register" id="btnRegister">
                        <i class="fas fa-check-circle"></i>
                        <span id="btnRegisterText">Enregistrer Face ID</span>
                    </button>

                    <button type="button" class="btn-action btn-retake" id="btnRetake">
                        <i class="fas fa-redo"></i>
                        <span>Reprendre</span>
                    </button>
                </div>

                <div class="message-box error" id="errorBox">
                    <i class="fas fa-exclamation-circle"></i>
                    <span id="errorText"></span>
                </div>

                <div class="message-box success" id="successBox">
                    <i class="fas fa-check-circle"></i>
                    <span id="successText"></span>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const cameraZone = document.getElementById('cameraZone');
    const cameraPlaceholder = document.getElementById('cameraPlaceholder');
    const cameraPreview = document.getElementById('cameraPreview');
    const cameraOverlay = document.getElementById('cameraOverlay');
    const scanningLine = document.getElementById('scanningLine');
    const btnCapture = document.getElementById('btnCapture');
    const btnRegister = document.getElementById('btnRegister');
    const btnRetake = document.getElementById('btnRetake');
    const errorBox = document.getElementById('errorBox');
    const errorText = document.getElementById('errorText');
    const successBox = document.getElementById('successBox');
    const successText = document.getElementById('successText');
    const faceCanvas = document.getElementById('faceCanvas');

    if (!cameraZone) return;

    let stream = null;
    let isCameraActive = false;
    let capturedImage = null;

    // Activate camera on click
    cameraPlaceholder.addEventListener('click', startCamera);

    async function startCamera() {
        try {
            stream = await navigator.mediaDevices.getUserMedia({
                video: { facingMode: 'user', width: 640, height: 480 }
            });
            
            cameraPreview.srcObject = stream;
            cameraPreview.style.display = 'block';
            cameraPlaceholder.style.display = 'none';
            cameraOverlay.classList.add('active');
            isCameraActive = true;
            
            hideMessages();
        } catch (err) {
            showError('Impossible d\'accéder à la caméra. Vérifiez les permissions.');
        }
    }

    function stopCamera() {
        if (stream) {
            stream.getTracks().forEach(track => track.stop());
            stream = null;
        }
        isCameraActive = false;
    }

    // Capture
    btnCapture.addEventListener('click', function() {
        if (!isCameraActive) {
            startCamera();
            return;
        }

        scanningLine.style.display = 'block';
        
        setTimeout(() => {
            // Capture image
            faceCanvas.width = cameraPreview.videoWidth;
            faceCanvas.height = cameraPreview.videoHeight;
            const ctx = faceCanvas.getContext('2d');
            ctx.drawImage(cameraPreview, 0, 0);
            
            capturedImage = faceCanvas.toDataURL('image/jpeg', 0.9);
            
            // Stop camera and show captured frame
            stopCamera();
            cameraPreview.style.display = 'none';
            
            // Show captured image as background
            cameraZone.style.backgroundImage = `url(${capturedImage})`;
            cameraZone.style.backgroundSize = 'cover';
            cameraZone.style.backgroundPosition = 'center';
            
            scanningLine.style.display = 'none';
            cameraOverlay.classList.remove('active');
            
            // Show register/retake buttons
            btnCapture.style.display = 'none';
            btnRegister.style.display = 'inline-flex';
            btnRetake.style.display = 'inline-flex';
        }, 1500);
    });

    // Retake
    btnRetake.addEventListener('click', function() {
        capturedImage = null;
        cameraZone.style.backgroundImage = '';
        cameraPlaceholder.style.display = 'flex';
        
        btnCapture.style.display = 'inline-flex';
        btnRegister.style.display = 'none';
        btnRetake.style.display = 'none';
        
        hideMessages();
        startCamera();
    });

    // Register
    btnRegister.addEventListener('click', async function() {
        if (!capturedImage) {
            showError('Veuillez d\'abord capturer votre visage.');
            return;
        }

        const btnText = document.getElementById('btnRegisterText');
        const originalText = btnText.innerHTML;
        btnText.innerHTML = '<span class="spinner"></span> Enregistrement...';
        btnRegister.disabled = true;

        try {
            const formData = new FormData();
            formData.append('face_image', capturedImage);

            const response = await fetch('{{ path('profile_face_id_register') }}', {
                method: 'POST',
                body: formData
            });

            const result = await response.json();

            if (result.success) {
                showSuccess('Face ID enregistré avec succès ! La page va se recharger...');
                setTimeout(() => window.location.reload(), 2000);
            } else {
                showError(result.error || 'Erreur lors de l\'enregistrement.');
                btnText.innerHTML = originalText;
                btnRegister.disabled = false;
            }
        } catch (err) {
            showError('Erreur de connexion au serveur.');
            btnText.innerHTML = originalText;
            btnRegister.disabled = false;
        }
    });

    function showError(msg) {
        errorText.textContent = msg;
        errorBox.classList.add('show');
        successBox.classList.remove('show');
    }

    function showSuccess(msg) {
        successText.textContent = msg;
        successBox.classList.add('show');
        errorBox.classList.remove('show');
    }

    function hideMessages() {
        errorBox.classList.remove('show');
        successBox.classList.remove('show');
    }
});
</script>
{% endblock %}
